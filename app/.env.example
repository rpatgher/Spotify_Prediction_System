# Keycloak (OIDC) — copy to .env and adjust per environment.
# Vite inlines these at build time; rebuild after changing them.
VITE_KEYCLOAK_URL=https://your-keycloak-host
VITE_KEYCLOAK_REALM=your-realm
VITE_KEYCLOAK_CLIENT_ID=your-client-id
# Base URL the app is served from; used as the OIDC redirect target
# (login/logout). Must be covered by the client's valid redirect URIs.
VITE_APP_BASE_URL=https://your-app-host/
