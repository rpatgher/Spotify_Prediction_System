# ============================================================
# TrackWise Backend — environment variables
# Copy to `.env` and fill in the values you have.
# Anything you don't have yet (URLs, Keycloak, etc.) can stay
# as-is for now; the placeholders below let the app boot.
# ============================================================

# ---- Database (PostgreSQL) ----------------------------------
# When running with docker-compose, host is the service name `db`.
# For running the backend locally against the compose DB, use localhost:5432.
DATABASE_URL=postgresql+psycopg2://trackwise:trackwise@db:5432/trackwise

# ---- CORS ---------------------------------------------------
# Comma-separated list of allowed frontend origins. Use * to allow all (dev only).
CORS_ORIGINS=*

# ---- Keycloak (auth) ----------------------------------------
# TODO: fill these in once your Keycloak realm is available.
# AUTH_ENABLED=true  -> JWTs are validated against Keycloak (real auth).
# AUTH_ENABLED=false -> auth is bypassed for local dev (user_id taken from
#                       the `X-Debug-User` header, default "dev-user").
AUTH_ENABLED=true

# Issuer = the realm URL, e.g. https://keycloak.example.com/realms/trackwise
KEYCLOAK_ISSUER=
# JWKS endpoint, usually <issuer>/protocol/openid-connect/certs
KEYCLOAK_JWKS_URL=
# Expected audience (client id). Leave empty to skip audience verification.
KEYCLOAK_AUDIENCE=

# ---- Auth dev helpers (AUTH_ENABLED=false only) -----------
# Override the authenticated user id in dev mode:
#   X-Debug-User: my-local-user
# Override the user's realm roles in dev mode (comma-separated).
# Defaults to "usuario,productor" so local flows work out of the box.
#   X-Debug-Roles: usuario

# ---- Prod examples (placeholders — never put real values here) ------------
# Prod: KEYCLOAK_ISSUER=https://<lb-host>/realms/<realm>
# Prod: KEYCLOAK_JWKS_URL=http://<keycloak-internal-host>/realms/<realm>/protocol/openid-connect/certs
# Prod: DATABASE_URL=postgresql+psycopg2://<user>:<password>@<db-host>:5432/<database>
